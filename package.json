{
  "name": "eslint-prettier-project",
  "version": "1.0.0",
  "private": true,
  "description": "Atividade prática de padronização de código com ESLint e Prettier",
  "scripts": {
    "start": "node index.js",
    "lint": "eslint index.js",
    "lint:fix": "eslint index.js --fix",
    "format": "prettier --write index.js",
    "format:check": "prettier --check index.js"
  },
  "devDependencies": {
    "@eslint/js": "^9.0.0",
    "eslint": "^9.0.0",
    "eslint-config-prettier": "^10.0.0",
    "eslint-plugin-prettier": "^5.0.0",
    "globals": "^16.0.0",
    "prettier": "^3.0.0"
  }
}
